<?xml version="1.0"?>
<package format="3">
  <name>obca_navigation</name>
  <version>0.1.0</version>
  <description>F1TENTH ICP localization, raceline-guided rectangular OBCA planning and guarded tracking.</description>
  <maintainer email="parkm@example.com">parkm</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>pkg-config</build_depend>
  <depend>coinor-libipopt-dev</depend>
  <!-- Jammy's ipopt.pc explicitly links BLAS/LAPACK development symlinks. -->
  <build_depend>libblas-dev</build_depend>
  <build_depend>liblapack-dev</build_depend>
  <depend>rclcpp</depend>
  <depend>f110_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>kinematic_localization</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rcl_interfaces</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
